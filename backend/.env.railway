# =============================================
# MINUME XVII - Backend .env.railway
# =============================================
# Copia estas variables en Railway > Variables.
# El plugin MySQL de Railway provee automaticamente:
#   MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# (sin guiones bajos). NO las escribas manualmente.
# =============================================

PORT=$PORT
FRONTEND_URL=*
JWT_SECRET=minume_xvii_secret_key_2026_super_segura
JWT_EXPIRES_IN=24h
NODE_ENV=production

# Usa la variable del plugin MySQL de Railway:
DB_HOST=$MYSQLHOST
DB_PORT=$MYSQLPORT
DB_USER=$MYSQLUSER
DB_PASSWORD=$MYSQLPASSWORD
DB_NAME=$MYSQLDATABASE