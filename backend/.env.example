# =============================================
# MINUME XVII - Backend variables de entorno
# =============================================
# Copia este archivo a .env y edita los valores.

PORT=3001

# Origenes permitidos por CORS (separados por coma).
# Usa * para permitir todos (solo en pruebas).
FRONTEND_URL=http://localhost:3000

# ---- Conexion MySQL local ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contrasena_mysql
DB_NAME=minume_xvii
# Activa SSL si tu MySQL esta en un servicio externo (Supabase MySQL, PlanetScale, DigitalOcean...)
DB_SSL=false

# JWT
JWT_SECRET=cambia_esta_clave_secreta
JWT_EXPIRES_IN=24h
NODE_ENV=development

# =============================================
# CONEXION A SUPABASE MYSQL (hosting externo)
# =============================================
# En Supabase crea una base de datos MySQL (beta). Copia los datos de
# conexion que te da el panel (boton Connect) y usalos asi:
#
#   DB_HOST=<host que te da Supabase>
#   DB_PORT=<puerto que te da Supabase, normalmente 3306>
#   DB_USER=<usuario que te da Supabase>
#   DB_PASSWORD=<password de la base de datos>
#   DB_NAME=<nombre de la base de datos que te da Supabase>
#   DB_SSL=true
#
# IMPORTANTE: en Supabase el nombre de la DB y el usuario los asigna
# Supabase (no eliges tu). Copialos tal cual del panel.
#
# Luego crea las tablas y datos seed con backend/../database/minume_xvii.sql
# (OMITE las 2 primeras lineas: CREATE DATABASE y USE).
# =============================================