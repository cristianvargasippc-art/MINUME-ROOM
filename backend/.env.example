# =============================================
# MINUME XVII - Backend (variables de entorno)
# =============================================
# Plantilla SIN valores reales. Cópiala a backend/.env y complétala en LOCAL.
# backend/.env está en .gitignore: NUNCA se sube al repositorio.
# En producción (Hostinger) estas variables se cargan en el panel, no en un .env.
#
#   cp backend/.env.example backend/.env
# =============================================

# Entorno. En producción DEBE ser "production" (activa SSL a la BD y CSP).
NODE_ENV=development

# Origen(es) permitido(s) por CORS y Socket.IO (separados por coma).
# OJO: el código lee APP_URL (NO FRONTEND_URL).
# Local:      http://localhost:3000
# Producción: https://minume.celider10.digital
APP_URL=http://localhost:3000

# ---- Puerto ----
# En local puedes fijarlo. En Hostinger NO lo definas: el host asigna PORT.
PORT=3000

# =============================================
# BASE DE DATOS - Supabase (PostgreSQL)
# =============================================
# Recomendado: una sola connection string. Usa el "Session Pooler" de Supabase
# (host aws-0-<region>.pooler.supabase.com, puerto 5432, IPv4). La conexión
# directa db.<ref>.supabase.co es solo IPv6 y Hostinger no la alcanza.
#
# Supabase Dashboard > Project Settings > Database > Connection string > Session Pooler
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres

# Alternativa a DATABASE_URL (variables sueltas). Si defines DATABASE_URL,
# estas se ignoran. Déjalas comentadas si usas la connection string.
# DB_HOST=aws-0-TU_REGION.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.TU_PROJECT_REF
# DB_PASSWORD=TU_PASSWORD
# DB_NAME=postgres

# =============================================
# AUTENTICACIÓN JWT
# =============================================
# OBLIGATORIA: el servidor NO arranca sin JWT_SECRET (hace process.exit(1)).
# Genera una segura:  openssl rand -base64 32
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_de_32_o_mas_caracteres
JWT_EXPIRES_IN=24h
