# =============================================
# MINUME XVII - Backend variables de entorno
# =============================================
# Copia este archivo a .env y edita los valores.

PORT=3001

# Origenes permitidos por CORS (separados por coma).
# Usa * para permitir todos (solo en pruebas).
FRONTEND_URL=http://localhost:3000

# Conexion MySQL local
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contrasena_mysql
DB_NAME=minume_xvii

# JWT
JWT_SECRET=cambia_esta_clave_secreta
JWT_EXPIRES_IN=24h
NODE_ENV=development

# =============================================
# Despliegue en Railway.app:
# Usa el plugin MySQL de Railway. El provee:
#   MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# Entonces define en Railway > Variables:
#   DB_HOST=$MYSQLHOST  DB_PORT=$MYSQLPORT  DB_USER=$MYSQLUSER
#   DB_PASSWORD=$MYSQLPASSWORD  DB_NAME=$MYSQLDATABASE
#   FRONTEND_URL=*  NODE_ENV=production  PORT=$PORT
# =============================================