# ============================================
# MINUME XVII - PRODUCCIÓN (Hostinger + Supabase)
# ============================================
# Plantilla de referencia SIN secretos reales.
# En Hostinger, carga estas claves en: panel del proyecto > Environment variables > Add.
# NO subas un .env con valores reales al repositorio.
#
# NO definas PORT: Hostinger lo asigna y el server ya lee process.env.PORT.
# ============================================

# Entorno (activa SSL contra Supabase y las cabeceras de seguridad/CSP)
NODE_ENV=production

# URL pública de la app (dominio de Hostinger). El código lee APP_URL.
# Debe ir con https:// y sin barra final.
APP_URL=https://minume.celider10.digital

# ============================================
# SUPABASE (PostgreSQL) - Session Pooler (IPv4, puerto 5432)
# Supabase > Project Settings > Database > Connection string > Session Pooler
# ============================================
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres

# ============================================
# JWT (OBLIGATORIO)
# Genera un secreto:  openssl rand -base64 32
# ============================================
JWT_SECRET=REEMPLAZA_POR_UN_SECRETO_ALEATORIO_DE_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=24h
