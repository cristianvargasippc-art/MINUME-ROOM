# ============================================
# CONFIGURACIÓN DE PRODUCCIÓN - BACKEND
# ============================================
# Copia este archivo a .env y completa con tus valores reales

# Servidor
PORT=3001
NODE_ENV=production

# URL del Frontend (tu subdominio en Hostinger)
# Ejemplo: FRONTEND_URL=https://minume.tudominio.com
FRONTEND_URL=https://TU_SUBDOMINIO.TU_DOMINIO.COM

# ============================================
# SUPABASE (POSTGRESQL)
# ============================================
# Obtén estos valores en: Supabase Dashboard > Settings > Database
# Host: db.xxx.supabase.co (o el host de tu proyecto)
# Puerto: 5432 (por defecto en Supabase)
# Usuario: postgres
# Contraseña: la que definiste al crear el proyecto
# Base de datos: postgres (por defecto)

DB_HOST=db.TU_PROJECT_REF.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=TU_SUPABASE_DB_PASSWORD
DB_NAME=postgres

# Para Supabase, también puedes usar la connection string completa:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ============================================
# AUTENTICACIÓN JWT
# ============================================
# Genera un secreto seguro: openssl rand -base64 32
JWT_SECRET=TU_JWT_SECRET_SUPER_SEGURO_AQUI_MIN_32_CARACTERES
JWT_EXPIRES_IN=24h

# ============================================
# OPCIONAL: RATE LIMITING MÁS ESTRICTO EN PRODUCCIÓN
# ============================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100